# Managed by Ansible (provision_web.yaml). Do not edit on the host.
[Unit]
Description={{ app_name }} container
After=docker.service network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm --force {{ app_name }}
ExecStart=/usr/bin/docker run --rm --name {{ app_name }} \
  --publish {{ app_port }}:8000 \
  --read-only --tmpfs /tmp \
  --env APP_VERSION={{ app_version }} \
  --env GIT_SHA={{ git_sha }} \
  --env BUILD_NUMBER={{ build_number }} \
  {{ app_image }}
ExecStop=/usr/bin/docker stop --time 20 {{ app_name }}

[Install]
WantedBy=multi-user.target
